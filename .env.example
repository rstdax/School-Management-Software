# SIMS (Smart Institution Management System) Environment Variables
# Copy this file to .env in your root or individual app directories

# Firebase Modular Web App Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-sims-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-sims-project
VITE_FIREBASE_STORAGE_BUCKET=your-sims-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Multi-School Identification
VITE_DEFAULT_SCHOOL_ID=school-oakridge-01
VITE_SCHOOL_NAME="Oakridge International Academy"

# Note: If Firebase credentials are not provided, SIMS automatically operates
# in interactive Demo Mode with complete pre-seeded realistic school data.

